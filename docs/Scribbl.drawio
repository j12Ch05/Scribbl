                <mxCell id="e44" edge="1" parent="1" source="v16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;dashed=1;strokeWidth=1;" target="v14" value="logs, metrics">
