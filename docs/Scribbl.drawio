                <mxCell id="v45" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacing=6;" value="&lt;b&gt;Reading guide&lt;/b&gt;&lt;br&gt;Solid = request/data path. Dashed = async, optional or not yet decided. Orange boxes = open decisions in PROJECT_PLAN.md.&lt;br&gt;Cost guardrail: the $100 cap is AWS credits (new accounts get about $100, free plan ends after 6 months or when credits run out). Budget alerts watch gross usage, see plan section 6.6." vertex="1">
                    <mxGeometry height="90" width="520" x="20" y="880" as="geometry"/>
                </mxCell>
                <mxCell id="v46" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacing=6;" value="&lt;b&gt;Why one CloudFront for web and API&lt;/b&gt;&lt;br&gt;One origin: httpOnly SameSite=Strict cookies work and CORS is not needed. The default *.cloudfront.net name gives HTTPS with no domain. Weak spot: the CloudFront to EC2 hop is plain HTTP (no certificate for an amazonaws.com name). Mitigation: secret header + security group. Risk R-12. Emailed links contain this name, so never delete the distribution." vertex="1">
                    <mxGeometry height="80" width="520" x="560" y="960" as="geometry"/>
                </mxCell>
                <mxCell id="n9001" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacing=6;" value="&lt;b&gt;Environments are pipeline stages (team decision)&lt;/b&gt;&lt;br&gt;Dev: local Docker (React, Nest, Postgres)  &amp;gt;  Test: CI with a throwaway Postgres (prisma migrate deploy)  &amp;gt;  Staging: optional, only if credits remain  &amp;gt;  Production: the single AWS stack above. Only Production costs money." vertex="1">
                    <mxGeometry height="84" width="490" x="1100" y="970" as="geometry"/>
                </mxCell>
                <mxCell id="n9002" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#cccccc;spacing=6;" value="&lt;b&gt;Cut from v1&lt;/b&gt;&lt;br&gt;SMS provider, Resend + webhooks, Route 53 / custom domain. Bounce tracking is not available with Gmail SMTP." vertex="1">
                    <mxGeometry height="76" width="190" x="1380" y="400" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
