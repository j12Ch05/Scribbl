generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AuthChallenge {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @map("ac_id") @db.Uuid
  userId       String           @map("u_id") @db.Uuid
  purpose      ChallengePurpose @map("ac_purpose")
  codeHash     Bytes            @map("ac_code_hash")
  pendingValue String?          @map("ac_pending_value")
  createdAt    DateTime         @default(now()) @map("ac_created_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("ac_expires_at") @db.Timestamptz(6)
  attempts     Int              @default(0) @map("ac_attempts") @db.SmallInt
  consumedAt   DateTime?        @map("ac_consumed_at") @db.Timestamptz(6)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, purpose, createdAt(sort: Desc)], map: "auth_challenges_lookup")
  @@map("auth_challenges")
}

model EmailOutbox {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @map("eo_id") @db.Uuid
  userId         String?       @map("u_id") @db.Uuid
  toEmail        String        @map("eo_to_email")
  purpose        MailPurpose   @map("eo_purpose")
  type           String        @map("eo_type")
  payload        Json          @map("eo_payload")
  idempotencyKey String        @unique @map("eo_idempotency_key")
  priority       Int           @default(5) @map("eo_priority") @db.SmallInt
  status         OutboxStatus  @default(pending) @map("eo_status")
  attempts       Int           @default(0) @map("eo_attempts") @db.SmallInt
  mailAccountId  Int?          @map("eo_mail_account_id") @db.SmallInt
  providerMsgId  String?       @map("eo_provider_msg_id")
  createdAt      DateTime      @default(now()) @map("eo_created_at") @db.Timestamptz(6)
  sendAfter      DateTime      @default(now()) @map("eo_send_after") @db.Timestamptz(6)
  sentAt         DateTime?     @map("eo_sent_at") @db.Timestamptz(6)
  mailAccount    MailAccount?  @relation(fields: [mailAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status, priority, sendAfter], map: "email_outbox_due")
  @@index([mailAccountId, status, sentAt], map: "email_outbox_sent")
  @@map("email_outbox")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EventInvite {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("ei_id") @db.Uuid
  eventId      String    @map("ev_id") @db.Uuid
  createdById  String    @map("ei_created_by") @db.Uuid
  tokenHash    Bytes     @unique @map("ei_token_hash")
  inviteeEmail String    @map("ei_invitee_email")
  createdAt    DateTime  @default(now()) @map("ei_created_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("ei_expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("ei_used_at") @db.Timestamptz(6)
  usedById     String?   @map("ei_used_by") @db.Uuid
  revokedAt    DateTime? @map("ei_revoked_at") @db.Timestamptz(6)
  creator      User      @relation("EventInviteCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usedBy       User?     @relation("EventInviteUsedBy", fields: [usedById], references: [id], onUpdate: NoAction)
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, inviteeEmail], map: "one_pending_invite_per_email", where: raw("((ei_used_at IS NULL) AND (ei_revoked_at IS NULL))"))
  @@index([createdById, createdAt], map: "event_invites_creator_day")
  @@index([eventId], map: "event_invites_event_idx")
  @@map("event_invites")
}

model EventSubscription {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @map("es_id") @db.Uuid
  eventId        String    @map("ev_id") @db.Uuid
  userId         String    @map("u_id") @db.Uuid
  subscribedAt   DateTime  @default(now()) @map("es_subscribed_at") @db.Timestamptz(6)
  unsubscribedAt DateTime? @map("es_unsubscribed_at") @db.Timestamptz(6)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, userId], map: "one_active_subscription", where: raw("(es_unsubscribed_at IS NULL)"))
  @@index([eventId], map: "event_subscriptions_event_idx")
  @@index([userId], map: "event_subscriptions_user_idx")
  @@map("event_subscriptions")
}

model EventTag {
  eventId String @map("ev_id") @db.Uuid
  tagId   Int    @map("tg_id")
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([eventId, tagId])
  @@map("event_tags")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Event {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @map("ev_id") @db.Uuid
  userId         String              @map("u_id") @db.Uuid
  title          String              @map("ev_title")
  startAt        DateTime            @map("ev_start_at") @db.Timestamptz(6)
  durationMin    Int                 @map("ev_duration_min")
  endAt          DateTime            @default(now()) @map("ev_end_at") @db.Timestamptz(6)
  timezone       String              @map("ev_timezone")
  reminderMin    Int                 @default(60) @map("ev_reminder_min")
  location       String?             @map("ev_location")
  description    String?             @map("ev_description")
  color          String              @default("#6a00ff") @map("ev_color")
  maxSubscribers Int                 @default(999) @map("ev_max_subscribers")
  createdAt      DateTime            @default(now()) @map("ev_created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("ev_updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?           @map("ev_deleted_at") @db.Timestamptz(6)
  purgeAfter     DateTime?           @map("ev_purge_after") @db.Timestamptz(6)
  invites        EventInvite[]
  subscriptions  EventSubscription[]
  tags           EventTag[]
  user           User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  noteLinks      NoteEventLink[]
  reminderJobs   ReminderJob[]

  @@index([userId, startAt], map: "events_organizer_idx")
  @@index([startAt, endAt], map: "events_range_idx")
  @@index([purgeAfter], map: "events_trash_idx")
  @@map("events")
}

model LanguageType {
  id           Int            @id @map("lt_id") @db.SmallInt
  code         String         @unique @map("lt_code")
  name         String         @map("lt_name")
  isRtl        Boolean        @default(false) @map("lt_is_rtl")
  description  String?        @map("lt_description")
  userSettings UserSettings[]

  @@map("language_types")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MailAccount {
  id             Int           @id @default(autoincrement()) @map("ma_id") @db.SmallInt
  purpose        MailPurpose   @map("ma_purpose")
  address        String        @unique @map("ma_address")
  secretRef      String        @map("ma_secret_ref")
  dailyLimit     Int           @default(100) @map("ma_daily_limit")
  enabled        Boolean       @default(true) @map("ma_enabled")
  exhaustedUntil DateTime?     @map("ma_exhausted_until") @db.Timestamptz(6)
  note           String?       @map("ma_note")
  outbox         EmailOutbox[]

  @@map("mail_accounts")
}

model NoteEventLink {
  noteId  String @map("n_id") @db.Uuid
  eventId String @map("ev_id") @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  note    Note   @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([noteId, eventId])
  @@map("note_event_links")
}

model NoteLock {
  noteId      String   @id @map("n_id") @db.Uuid
  userId      String   @map("u_id") @db.Uuid
  sessionId   String   @map("s_id") @db.Uuid
  acquiredAt  DateTime @default(now()) @map("nl_acquired_at") @db.Timestamptz(6)
  heartbeatAt DateTime @default(now()) @map("nl_heartbeat_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("nl_expires_at") @db.Timestamptz(6)
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sessionId], map: "note_locks_session_idx")
  @@index([userId], map: "note_locks_user_idx")
  @@map("note_locks")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Note {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @map("n_id") @db.Uuid
  workspaceId  String          @map("w_id") @db.Uuid
  name         String          @map("n_name")
  s3Key        String          @unique @map("n_s3_key")
  sizeBytes    Int             @default(0) @map("n_size_bytes")
  version      Int             @default(1) @map("n_version")
  lastEditorId String?         @map("n_last_editor") @db.Uuid
  createdAt    DateTime        @default(now()) @map("n_created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("n_updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?       @map("n_deleted_at") @db.Timestamptz(6)
  purgeAfter   DateTime?       @map("n_purge_after") @db.Timestamptz(6)
  eventLinks   NoteEventLink[]
  lock         NoteLock?
  lastEditor   User?           @relation(fields: [lastEditorId], references: [id], onUpdate: NoAction)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([purgeAfter], map: "notes_trash_idx")
  @@index([workspaceId], map: "notes_workspace_idx")
  @@map("notes")
}

model ReminderJob {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @map("rj_id") @db.Uuid
  eventId  String       @map("ev_id") @db.Uuid
  kind     ReminderKind @map("rj_kind")
  fireAt   DateTime     @map("rj_fire_at") @db.Timestamptz(6)
  status   JobStatus    @default(pending) @map("rj_status")
  lockedAt DateTime?    @map("rj_locked_at") @db.Timestamptz(6)
  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eventId, kind])
  @@index([status, fireAt], map: "reminder_jobs_due")
  @@map("reminder_jobs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model RetentionPolicy {
  object String @id @map("rp_object")
  days   Int    @default(15) @map("rp_days")

  @@map("retention_policy")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Session {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @map("s_id") @db.Uuid
  userId        String         @unique(map: "one_active_session_per_user", where: raw("(s_revoked_at IS NULL)")) @map("u_id") @db.Uuid
  refreshHash   Bytes          @unique @map("s_refresh_hash")
  createdAt     DateTime       @default(now()) @map("s_created_at") @db.Timestamptz(6)
  lastUsedAt    DateTime       @default(now()) @map("s_last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime       @map("s_expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("s_revoked_at") @db.Timestamptz(6)
  revokedReason RevokeReason?  @map("s_revoked_reason")
  userAgent     String?        @map("s_user_agent")
  ip            String?        @map("s_ip") @db.Inet
  noteLocks     NoteLock[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "sessions_user_idx")
  @@map("sessions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Tag {
  id            Int            @id @default(autoincrement()) @map("tg_id")
  name          String         @unique @map("tg_name")
  data          Json           @map("tg_data")
  eventTags     EventTag[]
  workspaceTags WorkspaceTag[]

  @@index([data], map: "tags_data_gin", type: Gin)
  @@map("tags")
}

model ThemeType {
  id           Int            @id @map("tt_id") @db.SmallInt
  name         String         @unique @map("tt_name")
  colors       Json           @map("tt_colors")
  description  String?        @map("tt_description")
  userSettings UserSettings[]

  @@map("theme_types")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model UserSettings {
  userId         String       @id @map("u_id") @db.Uuid
  themeTypeId    Int          @map("tt_id") @db.SmallInt
  languageTypeId Int          @map("lt_id") @db.SmallInt
  font           String       @default("system") @map("us_font")
  accentColor    String       @default("#6a00ff") @map("us_accent_color")
  time24h        Boolean      @default(true) @map("us_time_24h")
  dateFormat     DateFormat   @default(DMY) @map("us_date_format")
  monthNumeric   Boolean      @default(false) @map("us_month_numeric")
  weekStart      Int          @default(1) @map("us_week_start") @db.SmallInt
  timezone       String       @default("UTC") @map("us_timezone")
  highContrast   Boolean      @default(false) @map("us_high_contrast")
  largeText      Boolean      @default(false) @map("us_large_text")
  reducedMotion  Boolean      @default(false) @map("us_reduced_motion")
  languageType   LanguageType @relation(fields: [languageTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  themeType      ThemeType    @relation(fields: [themeTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("user_settings")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model User {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @map("u_id") @db.Uuid
  username             String              @map("us_username")
  usernameChangedAt    DateTime?           @map("us_username_changed_at") @db.Timestamptz(6)
  firstNameEnc         Bytes               @map("us_first_name_enc")
  lastNameEnc          Bytes               @map("us_last_name_enc")
  email                String              @unique(map: "users_email_uq") @map("us_email")
  phoneEnc             Bytes?              @map("us_phone_enc")
  birthDateEnc         Bytes               @map("us_birth_date_enc")
  addressEnc           Bytes?              @map("us_address_enc")
  passwordHash         String              @map("us_password_hash")
  emailVerifiedAt      DateTime?           @map("us_email_verified_at") @db.Timestamptz(6)
  tosVersion           String              @map("us_tos_version")
  tosAcceptedAt        DateTime            @map("us_tos_accepted_at") @db.Timestamptz(6)
  failedLogins         Int                 @default(0) @map("us_failed_logins") @db.SmallInt
  lockedUntil          DateTime?           @map("us_locked_until") @db.Timestamptz(6)
  createdAt            DateTime            @default(now()) @map("us_created_at") @db.Timestamptz(6)
  deletedAt            DateTime?           @map("us_deleted_at") @db.Timestamptz(6)
  purgeAfter           DateTime?           @map("us_purge_after") @db.Timestamptz(6)
  authChallenges       AuthChallenge[]
  emailOutbox          EmailOutbox[]
  createdInvites       EventInvite[]       @relation("EventInviteCreator")
  usedInvites          EventInvite[]       @relation("EventInviteUsedBy")
  eventSubscriptions   EventSubscription[]
  events               Event[]
  noteLocks            NoteLock[]
  editedNotes          Note[]
  session              Session?
  settings             UserSettings?
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]

  @@index([purgeAfter], map: "users_purge_idx")
  @@map("users")
}

model WorkspaceMember {
  workspaceId String         @map("w_id") @db.Uuid
  userId      String         @map("u_id") @db.Uuid
  permission  WorkspacePerm  @default(read) @map("wm_permission")
  grantedAt   DateTime       @default(now()) @map("wm_granted_at") @db.Timestamptz(6)
  acceptedAt  DateTime?      @map("wm_accepted_at") @db.Timestamptz(6)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, userId])
  @@index([userId], map: "workspace_members_user_idx")
  @@map("workspace_members")
}

model WorkspaceTag {
  workspaceId String    @map("w_id") @db.Uuid
  tagId       Int       @map("tg_id")
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workspaceId, tagId])
  @@map("workspace_tags")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Workspace {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @map("w_id") @db.Uuid
  userId     String            @map("u_id") @db.Uuid
  name       String            @map("w_name")
  createdAt  DateTime          @default(now()) @map("w_created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @default(now()) @updatedAt @map("w_updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?         @map("w_deleted_at") @db.Timestamptz(6)
  purgeAfter DateTime?         @map("w_purge_after") @db.Timestamptz(6)
  notes      Note[]
  members    WorkspaceMember[]
  tags       WorkspaceTag[]
  user       User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "workspaces_owner_idx")
  @@index([purgeAfter], map: "workspaces_trash_idx")
  @@map("workspaces")
}

enum ChallengePurpose {
  password_reset
  email_verify
  email_change
  account_restore

  @@map("challenge_purpose")
}

enum DateFormat {
  DMY
  MDY
  YMD

  @@map("date_format")
}

enum JobStatus {
  pending
  processing
  done
  failed
  cancelled

  @@map("job_status")
}

enum MailPurpose {
  security
  reminder
  invite

  @@map("mail_purpose")
}

enum OutboxStatus {
  pending
  processing
  sent
  failed
  cancelled

  @@map("outbox_status")
}

enum ReminderKind {
  lead
  start

  @@map("reminder_kind")
}

enum RevokeReason {
  signed_out
  replaced_by_new_login
  expired
  password_changed
  account_deleted
  locked

  @@map("revoke_reason")
}

enum WorkspacePerm {
  read
  write

  @@map("workspace_perm")
}
